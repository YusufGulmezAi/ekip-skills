@page "/siteler"
@* GB12 deseninin onayli ilk ornegi (Yusuf, 02.10.2026). *@
@inject KonutYonetim.Web.Data.KonutDbContext Db

<SayfaBasligi Baslik="Siteler"><Eylemler><a class="dugme" href="/siteler/yeni">Yeni</a></Eylemler></SayfaBasligi>
<FiltreCubugu Ara="@Q" />
@if (_satirlar.Count == 0)
{
    <BosDurum />
}
else
{
    <Tablo TSatir="KonutYonetim.Yapi.Site" Satirlar="_satirlar" SatirAdresi="s => $&quot;/siteler/{s.PublicId}&quot;">
        <Basliklar><th>Ad</th></Basliklar>
        <Hucreler Context="s"><td>@s.Ad</td></Hucreler>
    </Tablo>
    <Sayfalama Sayfa="@Sayfa" Toplam="_toplam" />
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "sayfa")] public int Sayfa { get; set; } = 1;
    private List<KonutYonetim.Yapi.Site> _satirlar = [];
    private int _toplam;

    protected override async Task OnInitializedAsync()
    {
        var sorgu = Db.Siteler.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(Q)) { var t = TextNormalizer.ForSearch(Q); sorgu = sorgu.Where(s => s.AdArama.Contains(t)); }
        _toplam = await sorgu.CountAsync();
        _satirlar = await sorgu.OrderBy(s => s.Ad).Skip((Math.Max(Sayfa, 1) - 1) * 10).Take(10).ToListAsync();
    }
}
